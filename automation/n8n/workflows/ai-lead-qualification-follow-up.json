{
  "name": "AI Lead Qualification & Follow-Up",
  "nodes": [
    {
      "id": "5399ed3d-27a5-4fec-abb4-7e8b88b29fa7",
      "name": "Receive lead submission",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "authentication": "none",
        "responseMode": "onReceived",
        "options": {
          "noResponseBody": false,
          "responseCode": { "values": { "responseCode": 200 } },
          "responseData": "{\"accepted\":true}",
          "onlyRunIf": "={{ $json.headers[\"x-n8n-secret\"] === ($vars.N8N_SHARED_SECRET || $env.N8N_SHARED_SECRET) }}"
        }
      },
      "webhookId": "f8c35e0b-48b5-4908-9990-cc69fcd3b37b"
    },
    {
      "id": "b2fab00b-530d-4b79-a422-9f9ee453d8b9",
      "name": "Prepare persisted submission",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [224, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ ($vars.APP_BASE_URL || $env.APP_BASE_URL) + '/api/internal/process' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-secret",
              "value": "={{ $vars.N8N_SHARED_SECRET || $env.N8N_SHARED_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { submissionId: $json.body.submissionId } }}",
        "options": { "timeout": 30000 }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "ede91dd2-767a-4168-a231-d9c4e2fe4002",
      "name": "Check pending submissions every five minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [0, 320],
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] }
      }
    },
    {
      "id": "060fbbbc-bffe-4bc5-8bad-18d2bd7ba36e",
      "name": "Load pending submissions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [224, 320],
      "parameters": {
        "method": "GET",
        "url": "={{ ($vars.APP_BASE_URL || $env.APP_BASE_URL) + '/api/internal/pending' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-secret",
              "value": "={{ $vars.N8N_SHARED_SECRET || $env.N8N_SHARED_SECRET }}"
            }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "6015e757-dfe2-49d5-afde-80d3aadfcdd7",
      "name": "Split pending submissions",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [448, 320],
      "parameters": {
        "fieldToSplitOut": "submissions",
        "include": "noOtherFields",
        "options": {}
      }
    },
    {
      "id": "9267f679-baa5-421f-9b57-4e06b9829d84",
      "name": "Prepare recovered submission",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [672, 320],
      "parameters": {
        "method": "POST",
        "url": "={{ ($vars.APP_BASE_URL || $env.APP_BASE_URL) + '/api/internal/process' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-secret",
              "value": "={{ $vars.N8N_SHARED_SECRET || $env.N8N_SHARED_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { submissionId: $json.id } }}",
        "options": { "timeout": 30000 }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "22a9e5a4-4904-4d40-9268-b2461cfb8a11",
      "name": "AI analysis required?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [896, 80],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c7e3338b-d52c-4386-9b36-2d4dddb5e5e8",
              "leftValue": "={{ $json.analysisRequired }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "6202769e-9693-42cf-bf5b-f221aae5d95a",
      "name": "Analyze qualitative lead signals",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [1120, 0],
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify($json.analysisInput) }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "Analyze only the supplied lead information. Extract the stated problem, buying intent, urgency signals, risk evidence, and a concise recommended action. Never infer missing revenue, spend, headcount, identity, authority, or geography. Never calculate or recommend a numerical lead score. Cite short evidence from the supplied text for qualitative claims. Return only the required structured output.",
          "maxIterations": 1
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "c4e57e40-da80-4d26-97b8-3b82cfe1da53",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [1056, 208],
      "parameters": {
        "modelName": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "gpt-4.1-mini"
        },
        "responsesApiEnabled": true,
        "options": {
          "maxTokens": 700,
          "timeout": 15000,
          "maxRetries": 2
        }
      }
    },
    {
      "id": "aaf70ce7-d5db-4d3c-bbf7-acdeccb10da0",
      "name": "Lead analysis output schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [1248, 208],
      "parameters": {
        "jsonSchemaExample": "{\"problemSummary\":\"Concise stated problem\",\"intentSummary\":\"Concise buying-intent summary\",\"intentLevel\":\"ACTIVE_HELP\",\"problemAwareness\":\"CLEAR\",\"urgencySignals\":[],\"riskSignals\":[],\"recommendedAction\":\"Concise suggested next action\",\"evidence\":[{\"type\":\"problem\",\"sourceText\":\"Short exact evidence from supplied text\",\"confidence\":0.8}]}"
      }
    },
    {
      "id": "6b990588-f439-4bbb-a391-e66f4719ec8e",
      "name": "Complete AI-qualified submission",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [1408, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ ($vars.APP_BASE_URL || $env.APP_BASE_URL) + '/api/internal/complete' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-secret",
              "value": "={{ $vars.N8N_SHARED_SECRET || $env.N8N_SHARED_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { submissionId: $('AI analysis required?').item.json.submissionId, ...($json.output && typeof $json.output === 'object' ? { aiAnalysis: $json.output } : { aiFailureReason: 'AI_ANALYSIS_UNAVAILABLE' }) } }}",
        "options": { "timeout": 30000 }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "94039c7c-d2c2-4697-a1f1-d122d1e0e32d",
      "name": "Check due follow-ups hourly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [0, 576],
      "parameters": {
        "rule": {
          "interval": [
            { "field": "hours", "hoursInterval": 1, "triggerAtMinute": 0 }
          ]
        }
      }
    },
    {
      "id": "5e0b03f4-1578-4b84-aaed-7ca00bc66518",
      "name": "Create due follow-up drafts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [224, 576],
      "parameters": {
        "method": "POST",
        "url": "={{ ($vars.APP_BASE_URL || $env.APP_BASE_URL) + '/api/internal/follow-ups' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-secret",
              "value": "={{ $vars.N8N_SHARED_SECRET || $env.N8N_SHARED_SECRET }}"
            }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "ab1fa6dc-ada5-4f75-9e4b-e84aea0e08d1",
      "name": "Optional Slack notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [1664, 80],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.SLACK_WEBHOOK_URL || $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ text: `Lead ${$json.result?.decision?.classification || 'PENDING'} · route ${$json.result?.routing?.route || 'PENDING'} · submission ${$json.submissionId}` }) }}",
        "options": { "timeout": 10000 }
      },
      "disabled": true,
      "notes": "Enable only after SLACK_WEBHOOK_URL is configured. Email remains draft-only in V1."
    }
  ],
